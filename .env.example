# Base de datos (docker/compose.dev.yml levanta PostgreSQL en este puerto)
DATABASE_URL=postgresql://nexustrack:nexustrack@localhost:5442/nexustrack?schema=public
# Base de datos para pruebas de integración (se crea automáticamente en el contenedor)
DATABASE_URL_TEST=postgresql://nexustrack:nexustrack@localhost:5442/nexustrack_test?schema=public

# API
PORT=3100
# Secretos JWT: usar valores largos y aleatorios en producción (openssl rand -base64 48)
JWT_ACCESS_SECRET=cambiar-en-produccion-access
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7
# Origen permitido para CORS (solo necesario si la web no se sirve en el mismo dominio)
CORS_ORIGIN=http://localhost:4200
# strict: web y API en el mismo sitio. none: web en otro dominio (Firebase sin dominio propio), exige HTTPS.
COOKIE_SAMESITE=strict
# Ruta opcional a Chromium para generar PDF (por defecto usa el que descarga Puppeteer)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Usuario administrador inicial que crea el seed
SEED_ADMIN_EMAIL=admin@nexustrack.cl
SEED_ADMIN_PASSWORD=Admin123!
# Archivo Excel de origen para los datos iniciales
SEED_XLSX=docs/NexusTrack.xlsx
