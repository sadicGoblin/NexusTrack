# Producción (docker/compose.prod.yml). Copie a .env.produccion y complete. No lo suba al repositorio.
# Genere secretos con: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Dominio público (Caddy obtiene el certificado HTTPS). Vacío = solo HTTP en el puerto 80.
DOMINIO=
# Usuario administrador que crea la carga inicial.
SEED_ADMIN_EMAIL=admin@miempresa.cl
SEED_ADMIN_PASSWORD=
