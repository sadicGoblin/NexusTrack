# NexusTrack en el VPS (docker/compose.vps.yml). Copie a .env.vps en el servidor y complete.
# Genere secretos con: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Red Docker del Caddy existente. Para verla en el VPS:
#   docker inspect track-caddy --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
RED_PROXY=

# Dirección de la web. Varias separadas por coma.
CORS_ORIGIN=https://nexustrack-fletes.web.app,https://nexustrack-fletes.firebaseapp.com
# none: la web (web.app) y la API (su dominio) están en sitios distintos.
# strict: si la web usa un subdominio propio del mismo dominio que la API.
COOKIE_SAMESITE=none

# Administrador que crea la carga inicial.
SEED_ADMIN_EMAIL=admin@nexustrack.cl
SEED_ADMIN_PASSWORD=
