{
  "name": "nexustrack",
  "version": "1.0.0",
  "private": true,
  "description": "NexusTrack: plataforma de gestión de fletes",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "postinstall": "prisma generate && npm run build:shared",
    "build:shared": "npm run build -w @nexustrack/shared",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @nexustrack/api",
    "dev:web": "npm --prefix apps/web start",
    "build": "npm run build:shared && npm run build -w @nexustrack/api && npm --prefix apps/web run build",
    "test": "npm run test -w @nexustrack/shared && npm run test -w @nexustrack/api && npm --prefix apps/web test",
    "test:e2e": "npm run test:e2e -w @nexustrack/api",
    "test:flujo": "npm run build -w @nexustrack/api && playwright test",
    "lint": "oxlint -c .oxlintrc.json apps/api/src apps/api/test apps/web/src packages/shared/src prisma e2e",
    "format": "prettier --write \"{apps/api/src,apps/api/test,apps/web/src,packages/shared/src,prisma,e2e}/**/*.{ts,html,scss}\" \"*.ts\"",
    "format:check": "prettier --check \"{apps/api/src,apps/api/test,apps/web/src,packages/shared/src,prisma,e2e}/**/*.{ts,html,scss}\" \"*.ts\"",
    "setup": "npm install && npm --prefix apps/web install",
    "deploy:web": "sh scripts/desplegar-web.sh",
    "deploy:api": "sh scripts/desplegar-api-vps.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.8.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
